                <source>Delete this comment?</source>
                <target>Diesen Kommentar löschen?</target>
            </trans-unit>
            <trans-unit id="action.comment" xml:space="preserve">
                <source>Comment</source>
                <target>Kommentieren</target>
            </trans-unit>
            <group id="decorator.openComments" restype="x-gettext-plurals">
                <trans-unit id="decorator.openComments[0]" xml:space="preserve">
                    <source>{0} open comment</source>
                    <target>{0} offener Kommentar</target>
                </trans-unit>
                <trans-unit id="decorator.openComments[1]" xml:space="preserve">
                    <source>{0} open comments</source>
                    <target>{0} offene Kommentare</target>
                </trans-unit>
            </group>
            <trans-unit id="dialog.title" xml:space="preserve">
                <source>Comment</source>
                <target>Kommentar</target>
            </trans-unit>
            <trans-unit id="dialog.cancel" xml:space="preserve">
                <source>Cancel</source>
                <target>Abbrechen</target>
            </trans-unit>
            <trans-unit id="dialog.about" xml:space="preserve">
                <source>About</source>
                <target>Betrifft</target>
            </trans-unit>
            <trans-unit id="dialog.wholeElement" xml:space="preserve">
                <source>The whole element</source>
                <target>Das ganze Element</target>
            </trans-unit>
            <trans-unit id="filter.pageOnly" xml:space="preserve">
                <source>Only this page</source>
                <target>Nur diese Seite</target>
            </trans-unit>
            <trans-unit id="filter.showResolved" xml:space="preserve">
                <source>Show resolved</source>
                <target>Erledigte anzeigen</target>
            </trans-unit>
