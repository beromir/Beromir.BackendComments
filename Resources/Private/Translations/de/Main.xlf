                <source>Select an element to comment on it.</source>
                <target>Wähle ein Element, um es zu kommentieren.</target>
            </trans-unit>
            <trans-unit id="dialog.on" xml:space="preserve">
                <source>On {0}</source>
                <target>Zu {0}</target>
            </trans-unit>
            <trans-unit id="dialog.placeholder" xml:space="preserve">
                <source>Add a comment…</source>
                <target>Kommentar schreiben…</target>
            </trans-unit>
            <trans-unit id="status.resolved" xml:space="preserve">
                <source>Resolved</source>
                <target>Erledigt</target>
            </trans-unit>
            <trans-unit id="action.resolve" xml:space="preserve">
                <source>Resolve</source>
                <target>Erledigen</target>
            </trans-unit>
            <trans-unit id="action.reopen" xml:space="preserve">
                <source>Reopen</source>
                <target>Wieder öffnen</target>
            </trans-unit>
            <trans-unit id="action.delete" xml:space="preserve">
                <source>Delete</source>
                <target>Löschen</target>
            </trans-unit>
