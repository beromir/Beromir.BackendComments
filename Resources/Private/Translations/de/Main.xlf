<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file original="" product-name="Beromir.BackendComments" source-language="en" target-language="de" datatype="plaintext">
        <body>
            <trans-unit id="plugin.name" xml:space="preserve">
                <source>Comments</source>
                <target>Kommentare</target>
            </trans-unit>
            <trans-unit id="panel.title" xml:space="preserve">
                <source>Comments</source>
                <target>Kommentare</target>
            </trans-unit>
            <trans-unit id="panel.noSite" xml:space="preserve">
